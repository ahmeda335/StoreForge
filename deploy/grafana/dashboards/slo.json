{
 "uid": "storeforge-slo",
 "title": "StoreForge SLOs",
 "tags": [
  "storeforge",
  "slo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Availability burn rate (1 = budget lasts 30 days; page above 14.4)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "storeforge:error_ratio:rate1h / 0.001",
     "legendFormat": "{{api}} 1h"
    },
    {
     "refId": "B",
     "expr": "storeforge:error_ratio:rate5m / 0.001",
     "legendFormat": "{{api}} 5m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency burn rate (share slower than objective / 5 %)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "storeforge:slow_ratio:rate1h / 0.05",
     "legendFormat": "{{api}} 1h"
    },
    {
     "refId": "B",
     "expr": "storeforge:slow_ratio:rate5m / 0.05",
     "legendFormat": "{{api}} 5m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency by API (objectives: storefront 200 ms, admin/api 300 ms)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/storefront/.*\"}[5m])))",
     "legendFormat": "storefront"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/admin/.*\"}[5m])))",
     "legendFormat": "admin"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/.*\"}[5m])))",
     "legendFormat": "developer api"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Requests per second by API",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "storeforge:requests:rate5m",
     "legendFormat": "{{api}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Load shedding: in flight (limit 64) and shed per second",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (storeforge_http_requests_in_flight)",
     "legendFormat": "in flight {{instance}}"
    },
    {
     "refId": "B",
     "expr": "sum(rate(storeforge_http_requests_shed_total[5m]))",
     "legendFormat": "shed/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "DB pool: waiting for a connection",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (hikaricp_connections_pending)",
     "legendFormat": "pending {{instance}}"
    },
    {
     "refId": "B",
     "expr": "sum by (instance) (rate(hikaricp_connections_acquire_seconds_sum[5m]))",
     "legendFormat": "acquire s/s {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Job queue (worker)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (status) (storeforge_jobs_queue_depth{status=~\"READY|DEAD\"})",
     "legendFormat": "{{status}}"
    },
    {
     "refId": "B",
     "expr": "max(storeforge_jobs_oldest_ready_age_seconds)",
     "legendFormat": "oldest READY age (s)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Instances up",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"storeforge\"}",
     "legendFormat": "{{instance}} ({{role}})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
   }
  }
 ]
}